{
  "name": "ai-mystery-room",
  "version": "1.0.0",
  "private": true,
  "description": "AI Mystery Room - Interactive Detective Investigation Game",
  "scripts": {
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"blue,green\" \"npm run server:dev\" \"npm run client:dev\"",
    "client:dev": "npm --prefix client run dev",
    "client:build": "npm --prefix client run build",
    "client:preview": "npm --prefix client run preview",
    "server:dev": "npm --prefix server run dev",
    "server:start": "npm --prefix server run start",
    "server:test": "npm --prefix server run test"
  },
  "keywords": [
    "ai",
    "gemini",
    "mystery",
    "game",
    "detective"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
